[debug] [2026-04-30T12:53:25.725Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/giac-app-9752c/rulesets {"name":"projects/giac-app-9752c/rulesets/49f519cd-8e80-42f0-88fc-cecb26a62181","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function lowerUserProfileExists() {\n      return exists(/databases/$(database)/documents/users/$(request.auth.uid));\n    }\n\n    function upperUserProfileExists() {\n      return exists(/databases/$(database)/documents/Users/$(request.auth.uid));\n    }\n\n    function lowerUserProfile() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid));\n    }\n\n    function upperUserProfile() {\n      return get(/databases/$(database)/documents/Users/$(request.auth.uid));\n    }\n\n    function requestIsTryingToBecomeAdmin() {\n      return request.resource.data.role == 'admin' || request.resource.data.Role == 'admin';\n    }\n\n    function isAdmin() {\n      return isSignedIn() && (\n        (lowerUserProfileExists() && (lowerUserProfile().data.role == 'admin' || lowerUserProfile().data.Role == 'admin')) ||\n        (upperUserProfileExists() && (upperUserProfile().data.role == 'admin' || upperUserProfile().data.Role == 'admin'))\n      );\n    }\n\n    function belongsToCurrentUser(data) {\n      return isSignedIn() && (data.userId == request.auth.uid || data.UserId == request.auth.uid);\n    }\n\n    match /users/{userId} {\n      allow read: if isOwner(userId) || isAdmin();\n      allow create: if isOwner(userId) && !requestIsTryingToBecomeAdmin();\n      allow update: if (isOwner(userId) && !requestIsTryingToBecomeAdmin()) || isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    match /Users/{userId} {\n      allow read: if isOwner(userId) || isAdmin();\n      allow create: if isOwner(userId) && !requestIsTryingToBecomeAdmin();\n      allow update: if (isOwner(userId) && !requestIsTryingToBecomeAdmin()) || isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    match /announcements/{announcementId} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /Announcements/{announcementId} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /courses/{courseId} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /Courses/{courseId} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /applications/{applicationId} {\n      allow read: if belongsToCurrentUser(resource.data) || isAdmin();\n      allow create: if belongsToCurrentUser(request.resource.data) || isAdmin();\n      allow update, delete: if belongsToCurrentUser(resource.data) || isAdmin();\n    }\n\n    match /Applications/{applicationId} {\n      allow read: if belongsToCurrentUser(resource.data) || isAdmin();\n      allow create: if belongsToCurrentUser(request.resource.data) || isAdmin();\n      allow update, delete: if belongsToCurrentUser(resource.data) || isAdmin();\n    }\n\n    match /services/{serviceId} {\n      allow read: if belongsToCurrentUser(resource.data) || isAdmin();\n      allow create: if belongsToCurrentUser(request.resource.data) || isAdmin();\n      allow update, delete: if belongsToCurrentUser(resource.data) || isAdmin();\n    }\n\n    match /Services/{serviceId} {\n      allow read: if belongsToCurrentUser(resource.data) || isAdmin();\n      allow create: if belongsToCurrentUser(request.resource.data) || isAdmin();\n      allow update, delete: if belongsToCurrentUser(resource.data) || isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-04-30T12:53:31.331535Z","metadata":{"services":["cloud.firestore"]}}
